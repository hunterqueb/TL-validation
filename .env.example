# space-track.org credentials. Copy to .env and fill in; .env is gitignored.
#
#   cp .env.example .env && $EDITOR .env
#
# tlv/spacetrack.py reads .env automatically (repo root). A real environment
# variable of the same name always wins, so CI can export instead.
#
# An account is free: https://www.space-track.org/auth/createAccount
# Rate limits are 30 requests/min and 300/hour -- tlv caches every query under
# data/tle/ and never loops over days.

SPACETRACK_USER=your-space-track-username
SPACETRACK_PASS=your-space-track-password
